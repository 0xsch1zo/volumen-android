@font-face {
    font-family: "Roboto";
    src: url("assets/Roboto-VariableFont_wdth\,wght.ttf");
}

body {
    font-family: "Roboto";
}

.loginPage {
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden display: flex;
    justify-content: center;
    flex-direction: column;
}

.loginFormContainer {
    display: flex;
    align-items: center;
    flex-direction: column;
}

.loginFormContainer-heading {
    margin: 3rem 0rem;
}

.loginFormContainer-form {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    width: 77dvw;
    max-width: 77dvw;
    --m3e-form-field-width: 77dvw;
    max-height: inherit;
}

.loginFormContainer-buttons {
    display: flex;
    width: 77dvw;
    height: 7.75rem;
    flex-direction: column;
    justify-content: space-between;
    --m3e-button-medium-label-text-font-weight: bold;
}

.pageBackground {
    position: absolute;
    height: 100dvh;
    z-index: -1;
    mask-size: contain;
    mask-repeat: no-repeat;
}

.pageBackground-6-sided-cookie {
    position: absolute;
    height: 34dvh;
    width: 34dvh;
    background-color: var(--md-sys-color-primary, #625B71);
    mask-image: url("assets/login-bg-shapes/6-sided-cookie.svg");
    mask-size: inherit;
    mask-repeat: inherit;
    top: 5dvh;
    left: -45dvw;
}

.pageBackground-9-sided-cookie {
    position: absolute;
    height: 40dvh;
    width: 40dvh;
    background-color: var(--md-sys-color-primary, #6750A4);
    mask-image: url("assets/login-bg-shapes/9-sided-cookie.svg");
    mask-size: inherit;
    mask-repeat: inherit;
    left: -25dvw;
    bottom: -20dvh;
}

.pageBackground-circle {
    position: absolute;
    height: 30dvh;
    width: 30dvh;
    background-color: var(--md-sys-color-primary, #a39eeb);
    opacity: 70%;
    mask-image: url("assets/login-bg-shapes/circle.svg");
    mask-size: inherit;
    mask-repeat: inherit;
    top: 18dvh;
    right: -124.5dvw;
}

.pageBackground-pentagon {
    position: absolute;
    height: 23dvh;
    width: 23dvh;
    background-color: var(--md-sys-color-primary, #625B71);
    opacity: 70%;
    mask-image: url("assets/login-bg-shapes/pentagon.svg");
    mask-size: inherit;
    mask-repeat: inherit;
    bottom: 12dvh;
    right: -115dvw;
}
